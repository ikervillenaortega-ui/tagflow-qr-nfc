# Puerto HTTP
PORT=3000

# Nombre de la plataforma (se muestra en la interfaz)
APP_NAME=TagFlow

# URL pública de la plataforma (sin barra final).
# Si se deja vacía se deduce automáticamente del host de cada petición.
BASE_URL=

# Ruta del fichero SQLite (se crea automáticamente)
DB_PATH=data/app.db

# ------------------------------------------------------------------
# Seguridad: cambia estos valores antes de desplegar (mín. 16 chars)
# ------------------------------------------------------------------
# Secreto para firmar las cookies de sesión
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Clave maestra para cifrar las contraseñas WiFi en la base de datos
WIFI_SECRET=cambia-esto-por-otra-cadena-larga-y-aleatoria

# 'true' si la plataforma se sirve por HTTPS (activa la cookie Secure)
COOKIE_SECURE=false

# 'true' si está detrás de un proxy inverso (nivel 1)
TRUST_PROXY=false

# 'production' en despliegue (exige SESSION_SECRET y WIFI_SECRET)
NODE_ENV=development