<%- include('partials/header', { title, active }) %>
<section class="page-head">
  <h1><%= tag ? 'Editar Tag' : 'Nuevo Tag' %></h1>
  <% if (tag) { %><a class="link" href="/admin/tags/<%= tag.id %>">← Volver al detalle</a><% } %>
</section>

<% if (errors.length > 0) { %>
  <div class="flash error"><ul><% for (const e of errors) { %><li><%= e %></li><% } %></ul></div>
<% } %>

<form method="post" action="<%= tag ? '/admin/tags/' + tag.id : '/admin/tags' %>" class="tag-form" id="tag-form" data-mode="<%= tag ? 'edit' : 'create' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <fieldset>
    <legend>Identificación</legend>
    <div class="form-grid">
      <label>Nombre descriptivo *
        <input type="text" name="nombre" required maxlength="120" value="<%= values ? values.nombre : (tag ? tag.nombre : '') %>" placeholder="Ej. Apartamento Centro 2B">
      </label>
      <label>Slug (opcional)
        <input type="text" name="slug" maxlength="64" pattern="[A-Za-z0-9_\-]{3,64}" value="<%= values ? values.slug : (tag ? tag.slug : '') %>" placeholder="Autogenerado si se deja vacío">
        <small>La URL pública será /t/<strong><%= slugPreview %></strong></small>
      </label>
      <label>Tipo de soporte *
        <select name="tipo">
          <% const tipoSel = values ? values.tipo : (tag ? tag.tipo : 'nfc'); %>
          <option value="qr" <%= tipoSel === 'qr' ? 'selected' : '' %>>QR</option>
          <option value="nfc" <%= tipoSel === 'nfc' ? 'selected' : '' %>>NFC</option>
          <option value="ambos" <%= tipoSel === 'ambos' ? 'selected' : '' %>>QR + NFC (mismo destino)</option>
        </select>
      </label>
    </div>
  </fieldset>

  <fieldset>
    <legend>Modo de destino</legend>
    <div class="modo-cards">
      <% const modoSel = (values && values.modo) ? values.modo : (preselectModo || (tag ? tag.modo : 'desactivado')); %>
      <label class="modo-card">
        <input type="radio" name="modo" value="url" <%= modoSel === 'url' ? 'checked' : '' %>>
        <strong>URL</strong>
        <span>Redirige al escanear a una web externa.</span>
      </label>
      <label class="modo-card">
        <input type="radio" name="modo" value="wifi" <%= modoSel === 'wifi' ? 'checked' : '' %>>
        <strong>WiFi</strong>
        <span>Muestra los datos de la red y permite conectarse.</span>
      </label>
      <label class="modo-card">
        <input type="radio" name="modo" value="contacto" <%= modoSel === 'contacto' ? 'checked' : '' %>>
        <strong>Contacto</strong>
        <span>Muestra teléfono y correo para llamar o escribir.</span>
      </label>
      <label class="modo-card">
        <input type="radio" name="modo" value="presentacion" <%= modoSel === 'presentacion' ? 'checked' : '' %>>
        <strong>Presentación</strong>
        <span>Tarjeta personal: foto circular, descripción y contacto.</span>
      </label>
      <label class="modo-card">
        <input type="radio" name="modo" value="alojamiento" <%= modoSel === 'alojamiento' ? 'checked' : '' %>>
        <strong>Alojamiento</strong>
        <span>Guía del huésped: acceso, WiFi, normas, manual y reseña.</span>
      </label>
      <label class="modo-card">
        <input type="radio" name="modo" value="desactivado" <%= modoSel === 'desactivado' ? 'checked' : '' %>>
        <strong>Desactivado</strong>
        <span>Página neutra: «aún no configurado».</span>
      </label>
    </div>
  </fieldset>

  <fieldset class="field-url">
    <legend>Redirección web</legend>
    <label>URL de destino *
      <input type="url" name="url_destino" value="<%= values ? values.url_destino : (tag ? tag.urlDestino : '') %>" placeholder="https://ejemplo.com/pagina">
      <small>Debe empezar por http:// o https://. El cambio se aplica al instante, sin tocar el QR/NFC físico.</small>
    </label>
  </fieldset>

  <fieldset class="field-wifi">
    <legend>Red WiFi</legend>
    <div class="form-grid">
      <label>SSID (nombre de la red) *
        <input type="text" name="wifi_ssid" maxlength="64" value="<%= values ? values.wifi_ssid : (tag ? tag.wifiSsid : '') %>" placeholder="MiRedWiFi">
      </label>
      <label>Contraseña
        <input type="text" name="wifi_password" autocomplete="off" value="<%= values ? values.wifi_password : (tag ? (wifiPasswordShown || '') : '') %>" placeholder="<%= tag ? 'La contraseña guardada ya está aquí: puedes verla o cambiarla' : 'Mín. 8 caracteres (WPA)' %>">
        <small>La contraseña guardada se muestra arriba para que puedas copiarla o cambiarla. Se guarda cifrada (AES-256-GCM) y viaja con el huésped para conectarlo con un toque.</small>
      </label>
      <div class="btn-row">
        <button type="button" class="btn btn-sm pw-reveal" data-pw-target="wifi_password" <%= tag && !wifiPasswordShown ? '' : 'hidden' %>>👁 Ver contraseña guardada</button>
        <span class="muted pw-reveal-note" hidden></span>
      </div>
      <label>Tipo de seguridad *
        <select name="wifi_seguridad">
          <% const segSel = values ? values.wifi_seguridad : (tag ? tag.wifiSeguridad : 'WPA'); %>
          <option value="WPA" <%= segSel === 'WPA' ? 'selected' : '' %>>WPA / WPA2 / WPA3</option>
          <option value="WEP" <%= segSel === 'WEP' ? 'selected' : '' %>>WEP</option>
          <option value="nopass" <%= segSel === 'nopass' ? 'selected' : '' %>>Sin contraseña (red abierta)</option>
        </select>
      </label>
    </div>
    <details>
      <summary>Vista previa del payload WiFi</summary>
      <code class="code-block" id="wifi-preview">WIFI:T:WPA;S:…;P:…;;</code>
    </details>
  </fieldset>

  <fieldset class="field-presentacion">
    <legend>Presentación personal</legend>
    <p class="muted">Tarjeta digital elegante: foto circular, presentación de la persona y contacto al final. Perfecta para tarjetas QR/NFC vendidas: configura la foto y los datos cuando se venda cada tarjeta.</p>
    <div class="pres-editor">
      <div class="pres-photo-box">
        <div class="pres-photo-ring" id="pres-photo-ring">
          <img id="pres-photo-preview" src="<%= tag && tag.presFoto ? tag.presFoto : '' %>" alt="Foto de la persona" hidden>
          <span class="pres-photo-placeholder" id="pres-photo-placeholder">
            <% const initialsSrc = tag && tag.presPersonaNombre ? tag.presPersonaNombre : (values && values.pres_persona_nombre) || (tag ? tag.nombre : ''); %>
            <% const ini = String(initialsSrc || '').trim().split(/\s+/).slice(0, 2).map(function (w) { return w.charAt(0).toUpperCase(); }).join('') || '👤'; %>
            <%= ini %>
          </span>
        </div>
        <div class="pres-photo-actions">
          <label class="btn btn-sm pres-photo-pick">
            📷 Elegir foto
            <input type="file" id="pres-foto-input" accept="image/png, image/jpeg" hidden>
          </label>
          <button type="button" class="btn btn-sm" id="pres-foto-remove" <%= tag && tag.presFoto ? '' : 'hidden' %>>Quitar</button>
          <small id="pres-foto-note"><%= tag && tag.presFoto ? 'Hay una foto guardada. Elige otra para sustituirla.' : 'JPG o PNG. Se ajusta sola a un círculo perfecto.' %></small>
        </div>
      </div>
      <input type="hidden" name="pres_foto_data" id="pres-foto-data">
      <input type="hidden" name="pres_foto_clear" id="pres-foto-clear" value="0">
      <div class="form-grid">
        <label>Nombre de la persona *
          <input type="text" name="pres_persona_nombre" maxlength="80" value="<%= values ? values.pres_persona_nombre : (tag ? tag.presPersonaNombre || '' : '') %>" placeholder="Ej. María García">
          <small>Nombre que se mostrará grande en la tarjeta.</small>
        </label>
        <label>Cargo o título
          <input type="text" name="pres_cargo" maxlength="80" value="<%= values ? values.pres_cargo : (tag ? tag.presCargo || '' : '') %>" placeholder="Ej. Directora Comercial">
          <small>Opcional, aparece bajo el nombre.</small>
        </label>
      </div>
      <label>Descripción
        <textarea name="pres_bio" id="pres-bio" rows="4" maxlength="600" placeholder="Una breve presentación profesional o personal…"><%= values ? values.pres_bio : (tag ? tag.presBio || '' : '') %></textarea>
        <small><span id="pres-bio-count">0</span>/600 caracteres.</small>
      </label>
      <p class="muted">El teléfono y el correo de contacto se añaden en la sección «Datos de contacto» de justo debajo: aparecerán al final de la tarjeta, con botones de llamar y escribir.</p>
    </div>
  </fieldset>

  <fieldset class="field-alojamiento">
    <legend>Alojamiento turístico · Guía del huésped</legend>
    <p class="muted">Rellena solo lo esencial: los bloques vacíos no aparecen en la página del huésped. El WiFi <strong>nunca</strong> se muestra como texto: se usa para conectar al móvil automáticamente al tocar el tag. Todo se puede cambiar más tarde sin reprogramar el QR/NFC físico.</p>

    <% function alojVal(lang, path) {
         const b = (blocksByLang && blocksByLang[lang]) || {};
         let cur = b;
         for (const seg of path.split('.')) { cur = cur && cur[seg]; }
         return cur == null ? '' : cur;
       } %>

    <% ['es','en'].forEach(function (lang, idx) {
         const isDefault = idx === 0;
         const hasContent = !!(blocksByLang && blocksByLang[lang] && Object.keys(blocksByLang[lang]).length);
         const normasItems = alojVal(lang, 'normas.items') || [];
         const manualItems = alojVal(lang, 'manual.items') || [];
         const recosItems = alojVal(lang, 'recomendaciones.items') || [];
    %>
    <div class="aloj-lang" data-lang="<%= lang %>">
      <div class="aloj-lang-head">
        <button type="button" class="aloj-lang-tab" data-lang-tab="<%= lang %>"><%= isDefault ? '🇪🇸 Español (principal)' : '🇬🇧 English (opcional)' %></button>
        <span class="muted aloj-lang-state"></span>
      </div>
      <div class="aloj-lang-body" <%= (isDefault || hasContent) ? '' : 'hidden' %>>
      <input type="hidden" name="b_<%= lang %>_present" value="0">

      <% if (!isDefault) { %>
      <p class="muted">Deja esta pestaña vacía si no quieres traducir: los huéspedes ingleses verán el contenido en español. Rellena solo los bloques que quieras traducir.</p>
      <% } %>

      <div class="aloj-section" data-block="acceso">
        <h4 class="aloj-block-title">🔑 Acceso al alojamiento</h4>
        <label class="aloj-field">
          <textarea name="b_<%= lang %>_acceso_texto" rows="3" maxlength="3000" placeholder="Código de la puerta, dónde está la llave, instrucciones del ascensor…"><%= alojVal(lang, 'acceso.texto') %></textarea>
        </label>
      </div>

      <div class="aloj-section" data-block="wifi">
        <h4 class="aloj-block-title">📶 WiFi (conexión automática)</h4>
        <label class="aloj-field">
          <span class="aloj-field-label">Nombre de la red (SSID)</span>
          <input type="text" name="b_<%= lang %>_aloj_wifi_ssid" maxlength="64" value="<%= alojVal(lang, 'wifi.ssid') %>" placeholder="MiRedWiFi">
          <span class="aloj-field-label">Contraseña</span>
          <input type="text" name="b_<%= lang %>_aloj_wifi_password" autocomplete="off" value="<%= values && values['b_' + lang + '_aloj_wifi_password'] ? values['b_' + lang + '_aloj_wifi_password'] : alojVal(lang, 'wifi.password') %>" placeholder="La que conecta los móviles de los huéspedes">
          <small>La contraseña guardada se muestra aquí: puedes copiarla o cambiarla. Se guarda cifrada (AES-256-GCM) y en la web del huésped aparece con un botón «Copiar».</small>
          <div class="btn-row">
            <button type="button" class="btn btn-sm pw-reveal" data-pw-target="b_<%= lang %>_aloj_wifi_password" <%= alojVal(lang, 'wifi.password') ? 'hidden' : '' %>>👁 Ver contraseña guardada</button>
            <span class="muted pw-reveal-note" hidden></span>
          </div>
        </label>
      </div>

      <div class="aloj-section" data-block="contacto">
        <h4 class="aloj-block-title">📞 Contacto del anfitrión</h4>
        <div class="form-grid">
          <label>WhatsApp (con prefijo internacional)
            <input type="text" name="b_<%= lang %>_aloj_contacto_whatsapp" maxlength="20" value="<%= alojVal(lang, 'contacto.whatsapp') %>" placeholder="+34600000000">
            <small>Botón directo a WhatsApp: el número no se muestra.</small>
          </label>
          <label>Teléfono (llamada)
            <input type="text" name="b_<%= lang %>_aloj_contacto_telefono" maxlength="20" value="<%= alojVal(lang, 'contacto.telefono') %>" placeholder="+34600000000">
            <small>Botón directo de llamada: el número no se muestra.</small>
          </label>
          <label>Correo electrónico
            <input type="email" name="b_<%= lang %>_aloj_contacto_email" maxlength="120" value="<%= alojVal(lang, 'contacto.email') %>" placeholder="anfitrion@ejemplo.com">
          </label>
        </div>
      </div>

      <div class="aloj-section" data-block="resena">
        <h4 class="aloj-block-title">⭐ Enlace de reseña</h4>
        <label class="aloj-field">
          <input type="url" name="b_<%= lang %>_resena_url" maxlength="2048" value="<%= alojVal(lang, 'resena.url') %>" placeholder="https://www.airbnb.com/r/… · https://g.page/r/…">
          <small>Se muestra como botón destacado «Deja tu reseña».</small>
        </label>
      </div>

      <details class="aloj-extra" <%= (normasItems.length || manualItems.length || recosItems.length) ? 'open' : '' %>>
        <summary>➕ Normas, manual y recomendaciones (opcional)</summary>

        <div class="aloj-section" data-block="normas">
          <h4 class="aloj-block-title">📋 Normas de la casa</h4>
          <div class="aloj-field">
            <% normasItems.forEach(function (it, i) { %>
              <input class="seed-hidden" type="hidden" name="b_<%= lang %>_normas_<%= i %>_text" value="<%= it.text %>">
            <% }) %>
            <input type="hidden" name="b_<%= lang %>_normas_present" value="<%= normasItems.length ? '1' : '0' %>">
            <div class="rowlist" data-rowlist data-prefix="b_<%= lang %>_normas" data-marker="b_<%= lang %>_normas_present" data-textfield="text">
              <template data-row-tpl>
                <div class="rowlist-row">
                  <input type="text" data-rf="text" placeholder="Una norma, p. ej.: silencio de 23:00 a 9:00">
                  <button type="button" class="rowlist-del" title="Quitar" aria-label="Quitar">✕</button>
                </div>
              </template>
              <div class="rowlist-rows"></div>
              <button type="button" class="btn btn-sm" data-row-add>+ Añadir norma</button>
            </div>
          </div>
        </div>

        <div class="aloj-section" data-block="manual">
          <h4 class="aloj-block-title">🏠 Manual de electrodomésticos</h4>
          <div class="aloj-field">
            <% manualItems.forEach(function (it, i) { %>
              <input class="seed-hidden" type="hidden" name="b_<%= lang %>_manual_<%= i %>_title" value="<%= it.title %>">
              <input class="seed-hidden" type="hidden" name="b_<%= lang %>_manual_<%= i %>_description" value="<%= it.description || '' %>">
              <input class="seed-hidden" type="hidden" name="b_<%= lang %>_manual_<%= i %>_media_url" value="<%= it.media_url || '' %>">
            <% }) %>
            <input type="hidden" name="b_<%= lang %>_manual_present" value="<%= manualItems.length ? '1' : '0' %>">
            <div class="rowlist" data-rowlist data-prefix="b_<%= lang %>_manual" data-marker="b_<%= lang %>_manual_present" data-textfield="title">
              <template data-row-tpl>
                <div class="rowlist-row">
                  <div class="rowlist-grid">
                    <input type="text" data-rf="title" placeholder="Aparato, p. ej.: Aire acondicionado">
                    <input type="text" data-rf="description" placeholder="Cómo se usa (opcional)">
                    <input type="url" data-rf="media_url" placeholder="Enlace a vídeo o foto (opcional)">
                  </div>
                  <button type="button" class="rowlist-del" title="Quitar" aria-label="Quitar">✕</button>
                </div>
              </template>
              <div class="rowlist-rows"></div>
              <button type="button" class="btn btn-sm" data-row-add>+ Añadir aparato</button>
            </div>
          </div>
        </div>

        <div class="aloj-section" data-block="recomendaciones">
          <h4 class="aloj-block-title">📍 Recomendaciones locales</h4>
          <div class="aloj-field">
            <% recosItems.forEach(function (it, i) { %>
              <input class="seed-hidden" type="hidden" name="b_<%= lang %>_recomendaciones_<%= i %>_title" value="<%= it.title %>">
              <input class="seed-hidden" type="hidden" name="b_<%= lang %>_recomendaciones_<%= i %>_category" value="<%= it.category || '' %>">
              <input class="seed-hidden" type="hidden" name="b_<%= lang %>_recomendaciones_<%= i %>_description" value="<%= it.description || '' %>">
            <% }) %>
            <input type="hidden" name="b_<%= lang %>_recomendaciones_present" value="<%= recosItems.length ? '1' : '0' %>">
            <div class="rowlist" data-rowlist data-prefix="b_<%= lang %>_recomendaciones" data-marker="b_<%= lang %>_recomendaciones_present" data-textfield="title">
              <template data-row-tpl>
                <div class="rowlist-row">
                  <div class="rowlist-grid">
                    <input type="text" data-rf="title" placeholder="Sitio, p. ej.: La Bodega">
                    <input type="text" data-rf="category" placeholder="Categoría: restaurante, farmacia…">
                    <input type="text" data-rf="description" placeholder="Nota corta (opcional)">
                  </div>
                  <button type="button" class="rowlist-del" title="Quitar" aria-label="Quitar">✕</button>
                </div>
              </template>
              <div class="rowlist-rows"></div>
              <button type="button" class="btn btn-sm" data-row-add>+ Añadir sitio</button>
            </div>
          </div>
        </div>
      </details>

      </div>
    </div>
    <% }); %>
    <p class="muted">💡 Pestañas de idioma: lo que escribas en una se conserva al cambiar a la otra. Cada idioma se guarda por separado.</p>
  </fieldset>

  <fieldset class="field-contacto">
    <legend>Datos de contacto</legend>
    <div class="form-grid">
      <label>Teléfono
        <input type="tel" name="contacto_telefono" maxlength="25" value="<%= values ? values.contacto_telefono : (tag ? tag.contactoTelefono : '') %>" placeholder="+34 600 000 000">
        <small>Se mostrará con botón «Llamar».</small>
      </label>
      <label>Correo electrónico
        <input type="email" name="contacto_email" maxlength="120" value="<%= values ? values.contacto_email : (tag ? tag.contactoEmail : '') %>" placeholder="hola@ejemplo.com">
        <small>Se mostrará con botón «Enviar correo».</small>
      </label>
    </div>
    <p class="muted">Al menos uno de los dos es obligatorio. Al escanear el QR/NFC se mostrarán con botones de llamar, escribir y copiar.</p>
  </fieldset>

  <fieldset class="field-nfc">
    <legend>Chip NFC (opcional)</legend>
    <p class="muted">Lee la tarjeta con el móvil para grabar aquí el <strong>UID único de su chip</strong> (p. ej. NTAG213): así sabrás siempre qué tarjeta física es esta ficha.</p>
    <div class="form-grid">
      <label>UID del chip
        <input type="text" name="nfc_uid" id="nfc-uid-field" maxlength="64" value="<%= values ? (values.nfc_uid || '') : (tag && tag.nfcUid ? tag.nfcUid : '') %>" placeholder="04:A3:B2:C1:5B:6A:80" autocomplete="off">
        <small>Hexadecimal; se admiten separadores «:» o espacios.</small>
      </label>
      <label>Modelo (si lo conoces)
        <input type="text" name="nfc_modelo" maxlength="40" value="<%= values ? (values.nfc_modelo || '') : (tag && tag.nfcModelo ? tag.nfcModelo : '') %>" placeholder="NTAG213">
      </label>
    </div>
    <div class="btn-row">
      <button type="button" class="btn" id="nfc-read-inline" hidden>📡 Leer chip con el móvil</button>
      <span class="muted" id="nfc-read-status"></span>
    </div>
  </fieldset>

  <fieldset>
    <legend>Estado</legend>
    <label>Estado
      <select name="estado">
        <% const estSel = values ? values.estado : (tag ? tag.estado : 'activo'); %>
        <option value="activo" <%= estSel === 'activo' ? 'selected' : '' %>>Activo (responde a los escaneos)</option>
        <option value="pausado" <%= estSel === 'pausado' ? 'selected' : '' %>>Pausado (muestra «no configurado»)</option>
      </select>
    </label>
  </fieldset>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary"><%= tag ? 'Guardar cambios' : 'Crear Tag' %></button>
    <a class="btn" href="<%= tag ? '/admin/tags/' + tag.id : '/admin/tags' %>">Cancelar</a>
  </div>
</form>
<%- include('partials/footer') %>
