<%- include('partials/header', { title, active }) %>
<section class="page-head">
  <h1><%= tag.nombre %></h1>
  <div class="page-actions">
    <% if (tag.modo === 'desactivado') { %>
      <a class="btn btn-primary" href="/admin/tags/<%= tag.id %>/editar?modo=contacto">Configurar para la venta</a>
      <a class="btn" href="/admin/tags/<%= tag.id %>/editar?modo=presentacion">Crear presentación</a>
    <% } %>
    <a class="btn" href="/admin/tags/<%= tag.id %>/editar">Editar</a>
    <form method="post" action="/admin/tags/<%= tag.id %>/estado" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn"><%= tag.estado === 'activo' ? 'Pausar' : 'Activar' %></button>
    </form>
    <form method="post" action="/admin/tags/<%= tag.id %>/eliminar" class="inline-form" data-confirm="¿Eliminar este Tag? Los escaneos registrados también se eliminarán.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-danger">Eliminar</button>
    </form>
  </div>
</section>

<div class="stat-cards">
  <div class="stat-card"><span class="stat-num"><%= tag.escaneos %></span><span class="stat-label">Escaneos totales</span></div>
  <div class="stat-card"><span class="stat-num"><%= fmtDate(tag.ultimoEscaneo) %></span><span class="stat-label">Último escaneo</span></div>
  <div class="stat-card"><span class="stat-num"><%= fmtDate(tag.fechaCreacion) %></span><span class="stat-label">Creado</span></div>
  <div class="stat-card"><span class="stat-num"><%= fmtDate(tag.fechaActualizacion) %></span><span class="stat-label">Modificado</span></div>
</div>

<section class="panel chart-panel" id="chart-panel"
  data-tag-id="<%= tag.id %>"
  data-series='<%= JSON.stringify(series) %>'
  data-origen='<%= JSON.stringify(origen) %>'>
  <h2>Gráfica de escaneos</h2>
  <p class="muted">Escaneos de este Tag por periodo. Usa las pestañas para cambiar entre vista diaria, semanal, mensual y anual.</p>
  <div class="chart-tabs" role="tablist">
    <button type="button" class="chart-tab active" data-range="daily" role="tab">Diario</button>
    <button type="button" class="chart-tab" data-range="weekly" role="tab">Semanal</button>
    <button type="button" class="chart-tab" data-range="monthly" role="tab">Mensual</button>
    <button type="button" class="chart-tab" data-range="yearly" role="tab">Anual</button>
  </div>
  <div class="chart-total"><span id="chart-total-num"><%= tag.escaneos %></span> <span class="muted">escaneos en total</span></div>
  <div class="chart-wrap">
    <div class="chart-canvas" id="chart-canvas" role="img" aria-label="Gráfica de escaneos por periodo"></div>
  </div>
  <div class="chart-origen">
    <h3>Origen de los escaneos</h3>
    <ul class="origen-list">
      <li><span class="origen-dot origen-directo-dot"></span> <strong id="origen-directo"><%= origen.directo %></strong> directos <span class="muted">(cámara, NFC o enlace abierto)</span></li>
      <li><span class="origen-dot origen-web-dot"></span> <strong id="origen-web"><%= origen.web %></strong> desde otras webs</li>
    </ul>
    <% if (origen.sites && origen.sites.length) { %>
    <p class="muted origen-sites">Sitios de procedencia: <% origen.sites.forEach(function (s, i) { %><%= s.host %> (<%= s.count %>)<% if (i < origen.sites.length - 1) { %> · <% } %><% }) %></p>
    <% } %>
  </div>
</section>

<% if (tag.modo === 'presentacion') { %>
<section class="panel pres-panel">
  <h2>Presentación personal</h2>
  <div class="pres-summary">
    <div class="pres-thumb">
      <% if (tag.presFoto) { %>
        <img src="<%= tag.presFoto %>" alt="Foto de <%= tag.presPersonaNombre || tag.nombre %>">
      <% } else { %>
        <span class="pres-thumb-initials"><%= String(tag.presPersonaNombre || tag.nombre || '').trim().split(/\s+/).slice(0, 2).map(function (w) { return w.charAt(0).toUpperCase(); }).join('') || '👤' %></span>
      <% } %>
    </div>
    <div class="pres-info">
      <strong class="pres-name"><%= tag.presPersonaNombre || tag.nombre %></strong>
      <% if (tag.presCargo) { %><div class="muted"><%= tag.presCargo %></div><% } %>
      <% if (tag.presBio) { %><p class="pres-bio-preview"><%= tag.presBio %></p><% } %>
      <% if (tag.presFoto) { %>
        <a class="btn btn-sm" href="/admin/tags/<%= tag.id %>/foto.png">⬇ Descargar foto circular (SVG)</a>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<section class="panel">
  <h2>URL pública</h2>
  <p class="muted">Esta URL es <strong>inmutable</strong>: imprímela en el QR o prográmala en la etiqueta NFC. El destino se decide desde el panel.</p>
  <div class="copy-row">
    <code class="code-block" id="public-url"><%= publicUrl %></code>
    <button type="button" class="btn btn-sm" data-copy="#public-url">Copiar</button>
  </div>
</section>

<section class="panel">
  <h2>Configuración actual</h2>
  <dl class="kv">
    <dt>Modo</dt>
    <dd><span class="badge badge-modo badge-<%= tag.modo %>"><%= tag.modo === 'url' ? 'URL' : (tag.modo === 'wifi' ? 'WiFi' : (tag.modo === 'contacto' ? 'Contacto' : (tag.modo === 'presentacion' ? 'Presentación' : 'Desactivado'))) %></span></dd>
    <% if (tag.modo === 'url') { %>
      <dt>Destino</dt>
      <dd><a href="<%= tag.urlDestino %>" target="_blank" rel="noopener"><%= tag.urlDestino %></a></dd>
    <% } else if (tag.modo === 'wifi') { %>
      <dt>Red</dt>
      <dd><strong><%= tag.wifiSsid %></strong> · <span class="badge badge-modo"><%= tag.wifiSeguridad === 'nopass' ? 'Sin contraseña' : tag.wifiSeguridad %></span></dd>
      <dt>Contraseña</dt>
      <dd><span class="mono" id="wifi-password"><%= tag.wifiPassword %></span> <button type="button" class="btn btn-sm" data-copy="#wifi-password">Copiar</button></dd>
    <% } else if (tag.modo === 'contacto') { %>
      <% if (tag.contactoTelefono) { %>
        <dt>Teléfono</dt>
        <dd><a href="tel:<%= tag.contactoTelefono %>"><%= tag.contactoTelefono %></a></dd>
      <% } %>
      <% if (tag.contactoEmail) { %>
        <dt>Correo</dt>
        <dd><a href="mailto:<%= tag.contactoEmail %>"><%= tag.contactoEmail %></a></dd>
      <% } %>
    <% } else if (tag.modo === 'presentacion') { %>
      <% if (tag.contactoTelefono) { %>
        <dt>Teléfono</dt>
        <dd><a href="tel:<%= tag.contactoTelefono %>"><%= tag.contactoTelefono %></a></dd>
      <% } %>
      <% if (tag.contactoEmail) { %>
        <dt>Correo</dt>
        <dd><a href="mailto:<%= tag.contactoEmail %>"><%= tag.contactoEmail %></a></dd>
      <% } %>
      <dt>vCard</dt>
      <dd><a class="link" href="/t/<%= tag.slug %>/contacto.vcf">Descargar tarjeta de contacto (.vcf)</a></dd>
    <% } else { %>
      <dt>Destino</dt>
      <dd class="muted">Este código muestra «aún no configurado». Cuando lo vendas, usa <a class="link" href="/admin/tags/<%= tag.id %>/editar?modo=contacto">Configurar para la venta</a> para poner el teléfono y el correo del comprador.</dd>
    <% } %>
    <dt>Soporte</dt>
    <dd><%= tag.tipo === 'ambos' ? 'QR + NFC' : tag.tipo.toUpperCase() %></dd>
    <dt>Estado</dt>
    <dd><span class="estado-btn estado-<%= tag.estado %>"><%= tag.estado === 'activo' ? 'Activo' : 'Pausado' %></span></dd>
  </dl>
</section>

<section class="panel">
  <h2>Descargar QR</h2>
  <p class="muted">Alta resolución, listo para imprimir. PNG para impresión, SVG para vectorial.</p>
  <div class="btn-row">
    <a class="btn" href="/admin/tags/<%= tag.id %>/qr.png?payload=url">QR · URL fija (PNG)</a>
    <a class="btn" href="/admin/tags/<%= tag.id %>/qr.svg?payload=url">QR · URL fija (SVG)</a>
    <% if (tag.modo === 'wifi') { %>
      <a class="btn" href="/admin/tags/<%= tag.id %>/qr.png?payload=wifi">QR · WiFi directo (PNG)</a>
      <a class="btn" href="/admin/tags/<%= tag.id %>/qr.svg?payload=wifi">QR · WiFi directo (SVG)</a>
    <% } %>
    <% if (tag.modo === 'contacto') { %>
      <a class="btn" href="/admin/tags/<%= tag.id %>/qr.png?payload=contacto">QR · Contacto (vCard, PNG)</a>
      <a class="btn" href="/admin/tags/<%= tag.id %>/qr.svg?payload=contacto">QR · Contacto (vCard, SVG)</a>
    <% } %>
    <% if (tag.modo === 'presentacion') { %>
      <a class="btn" href="/admin/tags/<%= tag.id %>/qr.png?payload=contacto">QR · Presentación (vCard, PNG)</a>
      <a class="btn" href="/admin/tags/<%= tag.id %>/qr.svg?payload=contacto">QR · Presentación (vCard, SVG)</a>
    <% } %>
  </div>
  <% if (tag.modo === 'wifi') { %>
    <p class="muted">El QR «WiFi directo» codifica el formato estándar <code>WIFI:…</code>: las cámaras de Android lo reconocen y conectan al instante, sin pasar por la web.</p>
  <% } %>
  <% if (tag.modo === 'contacto') { %>
    <p class="muted">El QR «Contacto» codifica una vCard: las cámaras del móvil ofrecen guardar el contacto directamente, sin pasar por la web.</p>
  <% } %>
  <% if (tag.modo === 'presentacion') { %>
    <p class="muted">El QR «Presentación» codifica una vCard con el nombre, el cargo y el contacto de la persona: al escanearlo con la cámara, el móvil ofrece guardar el contacto. Para ver la tarjeta completa (foto, descripción y botones) se escanea el «QR · URL fija», que abre la página de presentación.</p>
  <% } %>
</section>

<section class="panel">
  <h2>Payload NFC</h2>
  <p class="muted">Escribe uno de estos valores en la etiqueta con una app de escritura NFC (ej. NFC Tools, TagWriter) o desde el navegador si es compatible (Chrome en Android).</p>
  <div class="copy-row">
    <span class="label">URL (recomendado)</span>
    <code class="code-block" id="nfc-payload-url"><%= publicUrl %></code>
    <button type="button" class="btn btn-sm" data-copy="#nfc-payload-url">Copiar</button>
  </div>
  <% if (tag.modo === 'wifi') { %>
  <div class="copy-row">
    <span class="label">WiFi (texto NDEF)</span>
    <code class="code-block" id="nfc-payload-wifi"><%= wifiPayload %></code>
    <button type="button" class="btn btn-sm" data-copy="#nfc-payload-wifi">Copiar</button>
  </div>
  <% } %>
  <% if (tag.modo === 'contacto') { %>
  <div class="copy-row">
    <span class="label">Contacto (vCard)</span>
    <code class="code-block" id="nfc-payload-contacto"><%= contactoPayload %></code>
    <button type="button" class="btn btn-sm" data-copy="#nfc-payload-contacto">Copiar</button>
  </div>
  <% } %>
  <% if (tag.modo === 'presentacion') { %>
  <div class="copy-row">
    <span class="label">Presentación (vCard)</span>
    <code class="code-block" id="nfc-payload-contacto"><%= contactoPayload %></code>
    <button type="button" class="btn btn-sm" data-copy="#nfc-payload-contacto">Copiar</button>
  </div>
  <% } %>
  <div id="nfc-write" hidden>
    <p class="muted">Web NFC API detectada. Acerca la etiqueta al móvil y pulsa escribir.</p>
    <div class="btn-row">
      <button type="button" class="btn" data-nfc-write="url">Escribir URL en etiqueta</button>
      <% if (tag.modo === 'wifi') { %>
        <button type="button" class="btn" data-nfc-write="wifi">Escribir WiFi en etiqueta</button>
      <% } %>
      <% if (tag.modo === 'contacto') { %>
        <button type="button" class="btn" data-nfc-write="contacto">Escribir contacto en etiqueta</button>
      <% } %>
      <% if (tag.modo === 'presentacion') { %>
        <button type="button" class="btn" data-nfc-write="contacto">Escribir presentación en etiqueta</button>
      <% } %>
    </div>
    <p class="muted" id="nfc-status"></p>
  </div>
</section>

<section class="panel">
  <h2>Últimos escaneos</h2>
  <p class="muted">Ubicación aproximada (ciudad según la IP del escáner). El escaneo de un QR no pide permiso de localización al visitante.</p>
  <% if (scans.length === 0) { %>
    <p class="muted">Todavía no hay escaneos registrados.</p>
  <% } else { %>
  <ul class="scan-list">
    <% for (const s of scans) { %>
      <li>
        <span class="num"><%= fmtDate(s.created_at) %></span> · <span class="muted"><%= s.label %></span>
        <% if (s.location) { %>
          · <span class="scan-loc">📍 <%= s.location %></span>
          <% if (s.mapsUrl) { %> <a class="scan-map" href="<%= s.mapsUrl %>" target="_blank" rel="noopener">Ver en el mapa</a><% } %>
        <% } else if (s.note) { %>
          · <span class="muted" title="<%= s.note %>">📍 <%= s.note %></span>
        <% } else { %>
          · <span class="muted">ubicación no disponible</span>
        <% } %>
      </li>
    <% } %>
  </ul>
  <% } %>
</section>
<%- include('partials/footer') %>